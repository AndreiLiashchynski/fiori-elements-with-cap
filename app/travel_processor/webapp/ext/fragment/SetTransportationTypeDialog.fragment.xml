<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog 
        id="TravelSetTransportationType"
        title="{i18n>setTransportationType}">

        <VBox
            id="transportationVbox"
            class="sapUiSmallMargin">

            <RadioButtonGroup
                id="transportationRadioGroup"
                class="sapUiSmallMarginTop sapUiSmallMarginBottom"
            />

        </VBox>

        <buttons>

            <Button id="btnSave" text="{i18n>buttonSave}" type="Emphasized" press="onSavePress" />
            <Button id="btnCancel" text="{i18n>buttonCancel}" press="onCancelPress" />
        
        </buttons>
    
    
    </Dialog>

</core:FragmentDefinition>