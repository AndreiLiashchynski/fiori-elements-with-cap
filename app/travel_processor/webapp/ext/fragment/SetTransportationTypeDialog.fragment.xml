<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog 
        id="travelSetTransportationType"
        title="{i18n>setTransportationType}"
        contentWidth="25rem">

        <VBox
            id="transportationVbox"
            class="sapUiSmallMargin">

            <MultiComboBox
                id="transportationMultiCombo"
                items="{/TransportationType}"
                class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                <core:Item id="mulitComboItem" key="{code}" text="{name}" />
            </MultiComboBox>

        </VBox>

        <buttons>

            <Button id="btnSave" text="{i18n>buttonSave}" type="Emphasized" press="onSave" />
            <Button id="btnCancel" text="{i18n>buttonCancel}" press="onCancel" />
        
        </buttons>
    
    
    </Dialog>

</core:FragmentDefinition>