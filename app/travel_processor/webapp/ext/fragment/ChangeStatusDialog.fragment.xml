<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog id="ChangeStatusDialog" title="{i18n>changeStatus}">
        <VBox id="ChangeStatusVBox" alignItems="Center" justifyContent="Center">

            <HBox id="ChangeStatusHBox" alignItems="Center">
                <Label id="StatusLabel" text="{i18n>selectNewStatus}" labelFor="StatusSelect" class="sapUiSmallMarginEnd" />
                <Select 
                    id="StatusSelect"  
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom"
                    forceSelection="false"
                    valueStateText="{i18n>selectStatusRequired}"
                    items="{path: '/TransportStatus'}">
                        <core:Item
                            id="Status"
                            key="{code}" 
                            text="{name}" />
                </Select>
            </HBox>

        </VBox>
        <buttons>

            <Button id="BtnStatusSave" text="{i18n>buttonSave}" type="Emphasized" press="onChangeStatusSave" />
            <Button id="BtnStatusCancel" text="{i18n>buttonCancel}" press="onChangeStatusCancel" />

        </buttons>
    </Dialog>
</core:FragmentDefinition>