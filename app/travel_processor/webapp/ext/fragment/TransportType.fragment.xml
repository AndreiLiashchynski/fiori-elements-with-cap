<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <HBox id="transportationTypesContainer" items="{
        path: 'to_TransportationTypes',
        templateShareable: false
    }">
        <items>
            <core:Icon id="transportationTypeIcon"
                src="{path: 'transportationType_code', formatter: 'Formatter.mapTransportCodeToIcon'}" 
                class="sapUiTinyMarginEnd" 
                tooltip="{transportationType_code}" />
        </items>
    </HBox>
</core:FragmentDefinition>