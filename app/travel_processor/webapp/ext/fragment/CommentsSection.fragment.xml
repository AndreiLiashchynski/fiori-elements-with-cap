<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">
    <VBox id="commentsContainer" class="sapUiMediumMargin">
        
        <FeedInput
            id="CommentInput"
            post=".extension.sap.fe.cap.travel.ext.controller.CommentsHandler.onCommentPost"
            showIcon="true"
            class="sapUiSmallMarginBottom" />

        <List
            id="CommentsSectionList"
            noDataText="{i18n>emptyComments}" 
            items="{path: 'to_Comments', sorter: {path: 'createdAt', descending: true}}">
              <FeedListItem 
                id="CommentItem"
                sender="{createdBy}" 
                text="{CommentText}" 
                timestamp="{createdAt}">
                <FeedListItemAction 
                    id="deleteAction"
                    key="delete" 
                    text="{i18n>deleteButton}" 
                    icon="sap-icon://delete" 
                    press=".extension.sap.fe.cap.travel.ext.controller.CommentsHandler.onCommentDelete" />
            </FeedListItem>
        </List>

    </VBox>
</core:FragmentDefinition>