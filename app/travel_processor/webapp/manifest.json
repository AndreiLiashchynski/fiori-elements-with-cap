{
    "_version": "1.32.0",
    "sap.app": {
        "id": "sap.fe.cap.travel",
        "type": "application",
        "title": "{{title}}",
        "description": "{{description}}",
        "i18n": {
            "bundleName": "sap.fe.cap.travel.i18n.i18n",
            "supportedLocales": [
                "en",
                "de",
                "fr",
                ""
            ],
            "fallbackLocale": "en"
        },
        "applicationVersion": {
            "version": "1.0.0"
        },
        "dataSources": {
            "mainService": {
                "uri": "processor/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        },
        "offline": false,
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "ui5template.fiorielements.v4.lrop",
            "version": "1.0.0"
        },
        "crossNavigation": {
            "inbounds": {
                "Travel-manage": {
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    },
                    "semanticObject": "Travel",
                    "action": "manage",
                    "title": "Travels",
                    "subTitle": "Manage Travels",
                    "icon": "sap-icon://flight"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://flight",
            "favIcon": "sap-icon://flight",
            "phone": "sap-icon://flight",
            "phone@2": "sap-icon://flight",
            "tablet": "sap-icon://flight",
            "tablet@2": "sap-icon://flight"
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "handleValidation": true,
        "resources": {
            "css": []
        },
        "dependencies": {
            "minUI5Version": "1.136.9",
            "libs": {
                "sap.ui.core": {},
                "sap.fe.templates": {},
                "sap.f": {}
            }
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "sap.fe.cap.travel.i18n.i18n",
                    "supportedLocales": [
                        "en",
                        "de",
                        "fr",
                        ""
                    ],
                    "fallbackLocale": "en"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "routing": {
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "TravelList",
                    "target": [
                        "TravelList"
                    ]
                },
                {
                    "pattern": "Travel({key}):?query:",
                    "name": "TravelObjectPage",
                    "target": [
                        "TravelList",
                        "TravelObjectPage"
                    ]
                },
                {
                    "pattern": "Travel({key})/to_Booking({key2}):?query:",
                    "name": "BookingObjectPage",
                    "target": [
                        "TravelList",
                        "TravelObjectPage",
                        "BookingObjectPage"
                    ]
                },
                {
                    "name": "Travel_to_TransportationTypesObjectPage",
                    "pattern": "Travel({key})/to_TransportationTypes({to_TransportationTypesKey}):?query:",
                    "target": [
                        "TravelList",
                        "TravelObjectPage",
                        "Travel_to_TransportationTypesObjectPage"
                    ]
                }
            ],
            "targets": {
                "TravelList": {
                    "type": "Component",
                    "id": "TravelList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "entitySet": "Travel",
                            "enhanceI18n": "i18n/customTravel.properties",
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                                    "useSemanticDateRange": true
                                }
                            },
                            "navigation": {
                                "Travel": {
                                    "detail": {
                                        "route": "TravelObjectPage"
                                    }
                                }
                            },
                            "variantManagement": "Page",
                            "hideFilterBar": false,
                            "initialLoad": "Enabled",
                            "views": {
                                "paths": [
                                    {
                                        "key": "tableView",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView"
                                    },
                                    {
                                        "key": "tableView1",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView1"
                                    },
                                    {
                                        "key": "tableView2",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView2"
                                    }
                                ]
                            }
                        }
                    },
                    "controlAggregation": "beginColumnPages",
                    "contextPattern": ""
                },
                "TravelObjectPage": {
                    "type": "Component",
                    "id": "TravelObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "entitySet": "Travel",
                            "navigation": {
                                "to_Booking": {
                                    "detail": {
                                        "route": "BookingObjectPage"
                                    }
                                },
                                "to_TransportationTypes": {
                                    "detail": {
                                        "route": "Travel_to_TransportationTypesObjectPage"
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "to_TransportationTypes/@com.sap.vocabularies.UI.v1.LineItem#i18nTransportation": {
                                    "tableSettings": {
                                        "type": "ResponsiveTable",
                                        "creationMode": {
                                            "name": "Inline"
                                        },
                                        "personalization": {
                                            "column": true,
                                            "sort": true,
                                            "filter": true
                                        }
                                    },
                                    "columns": {
                                        "TransportationType": {
                                            "header": "{i18n>transportationtype}",
                                            "position": {
                                                "anchor": "DataField::Status_code",
                                                "placement": "Before"
                                            },
                                            "template": "sap.fe.cap.travel.ext.fragment.TransportationType",
                                            "width": "9rem"
                                        },
                                        "Comments1": {
                                            "header": "{i18n>comments}",
                                            "position": {
                                                "anchor": "DataField::Cost",
                                                "placement": "After"
                                            },
                                            "template": "sap.fe.cap.travel.ext.fragment.Comments",
                                            "width": "8rem"
                                        },
                                        "DataField::Status": {
                                            "width": "8rem"
                                        }
                                    },
                                    "actions": {
                                        "ChangeStatus": {
                                            "press": ".extension.sap.fe.cap.travel.ext.controller.ChangeStatusHandler.handleChangeStatusTypePress",
                                            "requiresSelection": true,
                                            "text": "{i18n>changeStatus}"
                                        }
                                    }
                                }
                            },
                            "editableHeaderContent": false
                        }
                    },
                    "controlAggregation": "midColumnPages",
                    "contextPattern": "/Travel({key})"
                },
                "BookingObjectPage": {
                    "type": "Component",
                    "id": "BookingObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "entitySet": "Booking",
                            "editableHeaderContent": false,
                            "controlConfiguration": {
                                "to_BookSupplement/@com.sap.vocabularies.UI.v1.LineItem": {
                                    "columns": {
                                        "ServingTimeOfMeals": {
                                            "header": "{i18n>servingTimeOfMeals}",
                                            "position": {
                                                "anchor": "DataField::Price",
                                                "placement": "After"
                                            },
                                            "template": "sap.fe.cap.travel.ext.fragment.ServingTimeOfMeals"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "controlAggregation": "endColumnPages",
                    "contextPattern": "/Travel({key})/to_Booking({key2})"
                },
                "Travel_to_TransportationTypesObjectPage": {
                    "type": "Component",
                    "id": "Travel_to_TransportationTypesObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "controlAggregation": "endColumnPages",
                    "options": {
                        "settings": {
                            "navigation": {},
                            "contextPath": "/Travel/to_TransportationTypes",
                            "controlConfiguration": {
                                "to_Comments/@com.sap.vocabularies.UI.v1.LineItem#i18nComments": {
                                    "tableSettings": {
                                        "personalization": {
                                            "column": true,
                                            "filter": true,
                                            "sort": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "contextPattern": "/Travel({key})/to_TransportationTypes({to_TransportationTypesKey})"
                }
            },
            "config": {
                "flexibleColumnLayout": {
                    "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
                    "defaultThreeColumnLayoutType": "ThreeColumnsEndExpanded"
                },
                "routerClass": "sap.f.routing.Router"
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.fe.templates.ListReport.ListReportController": {
                        "controllerNames": [
                            "sap.fe.cap.travel.ext.controller.SetTransportationType"
                        ]
                    },
                    "sap.fe.templates.ObjectPage.ObjectPageController": {
                        "controllerNames": [
                            "sap.fe.cap.travel.ext.controller.CommentsHandler",
                            "sap.fe.cap.travel.ext.controller.ChangeStatusHandler"
                        ]
                    }
                }
            }
        },
        "rootView": {
            "viewName": "sap.fe.templates.RootContainer.view.Fcl",
            "type": "XML",
            "async": true,
            "id": "appRootView"
        }
    },
    "sap.platform.abap": {
        "_version": "1.1.0",
        "uri": ""
    },
    "sap.platform.hcp": {
        "_version": "1.1.0",
        "uri": ""
    },
    "sap.fiori": {
        "_version": "1.1.0",
        "registrationIds": [],
        "archeType": "transactional"
    },
    "sap.cloud": {
        "public": true,
        "service": "sap.fe.cap.sflight"
    }
}
